    "hono": "^4.12.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/pg": "^8.16.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.65.0"
  }
